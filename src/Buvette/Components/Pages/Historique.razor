@page "/historique/{Id:int}"
@inject BuvetteService Service

<PageTitle>@(recap?.Evenement.Nom ?? "Historique") — historique</PageTitle>

@if (introuvable)
{
    <h1>Événement introuvable</h1>
    <a class="btn btn-primary" href="/">Retour à la liste</a>
}
else if (recap is null)
{
    <p class="text-secondary">Chargement…</p>
}
else
{
    <nav aria-label="fil d'Ariane" class="mb-2">
        <a href="/" class="text-decoration-none">← Tous les événements</a>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="mb-0">@recap.Evenement.Nom</h1>
            <p class="text-secondary mb-0">@recap.Evenement.Date.ToString("dddd d MMMM yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            @if (!recap.Evenement.Cloture)
            {
                <a class="btn btn-primary" href="/caisse/@Id">Caisse</a>
            }
            <a class="btn btn-outline-secondary" href="/export/@Id">Export Excel (CSV)</a>
            <button class="btn btn-outline-secondary" @onclick="ImprimerAsync">Imprimer</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card chiffre h-100">
                <div class="card-body">
                    <div class="chiffre-libelle">Total des ventes</div>
                    <div class="chiffre-valeur">@recap.TotalVentes.ToString("C2")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card chiffre h-100 border-success">
                <div class="card-body">
                    <div class="chiffre-libelle">Attendu en caisse</div>
                    <div class="chiffre-valeur text-success">@recap.TotalEnCaisse.ToString("C2")</div>
                    <div class="text-secondary small">dont @recap.Evenement.FondDeCaisse.ToString("C2") de fond de caisse</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card chiffre h-100">
                <div class="card-body">
                    <div class="chiffre-libelle">Commandes</div>
                    <div class="chiffre-valeur">@recap.NombreCommandes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card chiffre h-100">
                <div class="card-body">
                    <div class="chiffre-libelle">Panier moyen</div>
                    <div class="chiffre-valeur">@recap.PanierMoyen.ToString("C2")</div>
                </div>
            </div>
        </div>
        @if (recap.TotalOffert > 0)
        {
            <div class="col-6 col-lg-3">
                <div class="card chiffre h-100">
                    <div class="card-body">
                        <div class="chiffre-libelle">Offert</div>
                        <div class="chiffre-valeur text-secondary">@recap.TotalOffert.ToString("C2")</div>
                        <div class="text-secondary small">
                            @recap.NombreOffertes commande@(recap.NombreOffertes > 1 ? "s" : ""), hors recette
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (recap.Compte)
        {
            <div class="col-6 col-lg-3">
                <div class="card chiffre h-100 @(recap.EcartSignificatif ? "border-warning" : "border-success")">
                    <div class="card-body">
                        <div class="chiffre-libelle">Écart de caisse</div>
                        <div class="chiffre-valeur @(recap.EcartSignificatif ? "text-warning-emphasis" : "text-success")">
                            @(recap.Ecart!.Value >= 0 ? "+" : "")@recap.Ecart.Value.ToString("C2")
                        </div>
                        <div class="text-secondary small">compté @recap.Evenement.MontantCompte!.Value.ToString("C2")</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h4 mb-3">Ce qui a été vendu</h2>

    @if (recap.Produits.Count == 0)
    {
        <p class="text-secondary">Aucune vente enregistrée pour l'instant.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Produit</th>
                        <th scope="col" class="text-end">Prix unitaire</th>
                        <th scope="col" class="text-end">Quantité vendue</th>
                        <th scope="col" class="text-end">Montant</th>
                        @if (recap.TotalOffert > 0)
                        {
                            <th scope="col" class="text-end">Offerts</th>
                            <th scope="col" class="text-end">Sorti du stock</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in recap.Produits)
                    {
                        <tr>
                            <td>@ligne.Nom</td>
                            <td class="text-end">@ligne.PrixUnitaire.ToString("C2")</td>
                            <td class="text-end fw-semibold">@ligne.Quantite</td>
                            <td class="text-end">@ligne.Montant.ToString("C2")</td>
                            @if (recap.TotalOffert > 0)
                            {
                                <td class="text-end @(ligne.QuantiteOfferte > 0 ? "text-secondary" : "text-body-tertiary")">
                                    @(ligne.QuantiteOfferte > 0 ? ligne.QuantiteOfferte.ToString() : "—")
                                </td>
                                <td class="text-end">@ligne.QuantiteTotale</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot class="table-group-divider">
                    <tr class="fw-bold fs-5">
                        <td colspan="3">Total des ventes</td>
                        <td class="text-end">@recap.TotalVentes.ToString("C2")</td>
                        @if (recap.TotalOffert > 0)
                        {
                            <td colspan="2"></td>
                        }
                    </tr>
                    @if (recap.TotalOffert > 0)
                    {
                        <tr class="text-secondary">
                            <td colspan="3">
                                Offert (@recap.NombreOffertes commande@(recap.NombreOffertes > 1 ? "s" : ""))
                                — non encaissé
                            </td>
                            <td class="text-end">@recap.TotalOffert.ToString("C2")</td>
                            <td colspan="2"></td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3">Fond de caisse</td>
                        <td class="text-end">@recap.Evenement.FondDeCaisse.ToString("C2")</td>
                        @if (recap.TotalOffert > 0)
                        {
                            <td colspan="2"></td>
                        }
                    </tr>
                    <tr class="fw-bold fs-5 table-success">
                        <td colspan="3">Montant attendu dans la caisse</td>
                        <td class="text-end">@recap.TotalEnCaisse.ToString("C2")</td>
                        @if (recap.TotalOffert > 0)
                        {
                            <td colspan="2"></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <h2 class="h4 mb-3">Comptage de la caisse</h2>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="compte">Montant réellement compté (€)</label>
                    <input id="compte" class="form-control form-control-lg" type="number" step="0.01" min="0"
                           inputmode="decimal" placeholder="@recap.TotalEnCaisse.ToString("0.00")"
                           value="@Prix.PourChamp(montantCompte)"
                           @onchange="e => montantCompte = Prix.Analyser(e.Value?.ToString())" />
                    <div class="form-text">Fond de caisse et recette compris, tels qu'ils sont dans le tiroir.</div>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary btn-lg w-100" @onclick="EnregistrerComptageAsync">
                        Enregistrer
                    </button>
                </div>
                @if (recap.Compte)
                {
                    <div class="col-md-5">
                        @if (!recap.EcartSignificatif)
                        {
                            <div class="alert alert-success mb-0 py-2">
                                <strong>La caisse tombe juste.</strong>
                            </div>
                        }
                        else if (recap.Ecart is decimal e && e < 0)
                        {
                            <div class="alert alert-danger mb-0 py-2">
                                Il <strong>manque @((-e).ToString("C2"))</strong> par rapport à l'attendu.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0 py-2">
                                <strong>Excédent de @(recap.Ecart!.Value.ToString("C2"))</strong> par rapport à l'attendu.
                            </div>
                        }
                    </div>
                }
            </div>
            @if (recap.Compte && recap.EcartSignificatif)
            {
                <p class="text-secondary small mb-0 mt-3">
                    Avant de chercher plus loin : une consommation offerte non saisie, une erreur de
                    rendu de monnaie ou une commande encaissée deux fois expliquent la plupart des écarts.
                    Le détail des commandes ci-dessous permet de retrouver une saisie erronée.
                </p>
            }
            @if (comptageEnregistre)
            {
                <p class="text-success mb-0 mt-2">Comptage enregistré.</p>
            }
        </div>
    </div>

    <h2 class="h4 mb-3">
        Détail des commandes
        <button class="btn btn-sm btn-outline-secondary align-middle ms-2" @onclick="() => detailOuvert = !detailOuvert">
            @(detailOuvert ? "Masquer" : "Afficher")
        </button>
    </h2>

    @if (detailOuvert)
    {
        @if (commandes.Count == 0)
        {
            <p class="text-secondary">Aucune commande.</p>
        }
        else
        {
            <p class="text-secondary small">
                Annuler une commande la retire définitivement des totaux&nbsp;: à n'utiliser qu'en cas d'erreur de saisie.
            </p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" style="width:5rem">N°</th>
                            <th scope="col" style="width:7rem">Heure</th>
                            <th scope="col">Contenu</th>
                            <th scope="col" class="text-end" style="width:8rem">Total</th>
                            <th scope="col" style="width:11rem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in commandes)
                        {
                            <tr @key="c.Id" class="@(c.Offerte ? "table-secondary" : "")">
                                <td>@c.Id</td>
                                <td>@c.DateHeure.ToString("HH:mm")</td>
                                <td>
                                    @string.Join(", ", c.Lignes.Select(l => $"{l.Quantite} × {l.NomProduit}"))
                                    @if (c.Offerte)
                                    {
                                        <span class="badge text-bg-secondary ms-2">offert</span>
                                    }
                                </td>
                                <td class="text-end @(c.Offerte ? "text-secondary text-decoration-line-through" : "")">
                                    @c.Total.ToString("C2")
                                </td>
                                <td class="text-end">
                                    @if (annulationId == c.Id)
                                    {
                                        <span class="me-2 small">Annuler&nbsp;?</span>
                                        <button class="btn btn-sm btn-danger" @onclick="() => AnnulerAsync(c.Id)">Oui</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => annulationId = null">Non</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => annulationId = c.Id">
                                            Annuler
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private Recapitulatif? recap;
    private List<Commande> commandes = [];
    private bool introuvable;
    private bool detailOuvert;
    private int? annulationId;
    private decimal? montantCompte;
    private bool comptageEnregistre;

    protected override async Task OnParametersSetAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        recap = await Service.RecapitulatifAsync(Id);
        introuvable = recap is null;
        commandes = recap is null ? [] : await Service.ListerCommandesAsync(Id);
        montantCompte = recap?.Evenement.MontantCompte;
    }

    private async Task EnregistrerComptageAsync()
    {
        await Service.EnregistrerComptageAsync(Id, montantCompte);
        comptageEnregistre = true;
        await ChargerAsync();
    }

    private async Task AnnulerAsync(int commandeId)
    {
        annulationId = null;
        await Service.AnnulerCommandeAsync(commandeId);
        await ChargerAsync();
    }

    private async Task ImprimerAsync() => await JS.InvokeVoidAsync("window.print");
}

@page "/caisse/{Id:int}"
@inject BuvetteService Service
@inject ILogger<Caisse> Journal
@inject NotificationsBuvette Notifications
@implements IDisposable

<PageTitle>@(evenement?.Nom ?? "Caisse") — caisse</PageTitle>

@if (introuvable)
{
    <h1>Événement introuvable</h1>
    <a class="btn btn-primary" href="/">Retour à la liste</a>
}
else if (evenement is null)
{
    <p class="text-secondary">Chargement…</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">@evenement.Nom</h1>
            <p class="text-secondary mb-0">@evenement.Date.ToString("dddd d MMMM yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            @if (evenement.LieeAHelloAsso)
            {
                <a class="btn btn-outline-primary" href="/precommandes/@Id">Pré-commandes</a>
            }
            <a class="btn btn-outline-secondary" href="/historique/@Id">Historique</a>
            <a class="btn btn-outline-secondary" href="/evenement/@Id">Produits</a>
        </div>
    </div>

    @if (evenement.Cloture)
    {
        <div class="alert alert-warning">
            Cette buvette est clôturée. Pour encaisser à nouveau, rouvrez-la depuis la page
            <a href="/evenement/@Id">Produits</a>.
        </div>
    }

    @if (produits.Count == 0)
    {
        <div class="alert alert-info">
            Aucun produit en vente. <a href="/evenement/@Id">Ajoutez-en d'abord</a>.
        </div>
    }

    @if (message is not null)
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center" role="status">
            <span>@message</span>
            <button class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
        </div>
    }
    @if (erreur is not null)
    {
        <div class="alert alert-danger" role="alert">@erreur</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="produits-grille">
                @foreach (var p in produits)
                {
                    var quantite = Quantite(p.Id);
                    var disponible = Disponible(p);
                    <button type="button" class="produit-bouton @(quantite > 0 ? "actif" : "") @(disponible == 0 ? "epuise" : "")"
                            disabled="@(evenement.Cloture || disponible == 0)" @onclick="() => Ajouter(p.Id)">
                        @if (quantite > 0)
                        {
                            <span class="produit-badge">@quantite</span>
                        }
                        <span class="produit-nom">@p.Nom</span>
                        <span class="produit-prix">@p.Prix.ToString("C2")</span>
                        @if (p.AvecConsigne)
                        {
                            <span class="produit-consigne">+ @p.Consigne!.Value.ToString("C2") consigne</span>
                        }
                        @if (p.StockSuivi)
                        {
                            <span class="produit-stock @(disponible == 0 ? "vide" : disponible <= 5 ? "bas" : "")">
                                @(disponible == 0 ? "Épuisé" : $"Plus que {disponible}")
                            </span>
                        }
                    </button>
                }
            </div>

            @if (MontantsDeConsigne.Count > 0)
            {
                <h2 class="h5 mt-4 mb-2">Verres rapportés</h2>
                <div class="produits-grille">
                    @foreach (var montant in MontantsDeConsigne)
                    {
                        var nombre = Rendus(montant);
                        var restants = RenduPossible(montant);
                        <button type="button" class="produit-bouton retour-bouton @(nombre > 0 ? "actif" : "")"
                                disabled="@(evenement.Cloture || restants == 0)" @onclick="() => AjouterRendu(montant)">
                            @if (nombre > 0)
                            {
                                <span class="produit-badge">@nombre</span>
                            }
                            <span class="produit-nom">Verre rendu</span>
                            <span class="produit-prix">− @montant.ToString("C2")</span>
                            <span class="produit-stock">
                                @(restants == 0 ? "aucun verre à rembourser" : $"{restants} chez les clients")
                            </span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card panier">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Commande en cours</span>
                    @if (!PanierVide)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="Vider">Tout effacer</button>
                    }
                </div>

                @if (PanierVide)
                {
                    <div class="card-body text-secondary">
                        Touchez un produit pour commencer la commande.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var (produit, quantite) in Lignes)
                        {
                            <li class="list-group-item" @key="produit.Id">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@produit.Nom</div>
                                        <div class="text-secondary small">
                                            @quantite × @produit.Prix.ToString("C2")
                                        </div>
                                    </div>
                                    <div class="btn-group" role="group" aria-label="Quantité de @produit.Nom">
                                        <button class="btn btn-outline-secondary" @onclick="() => Retirer(produit.Id)"
                                                aria-label="Retirer un @produit.Nom">−</button>
                                        <span class="btn btn-light disabled quantite">@quantite</span>
                                        <button class="btn btn-outline-secondary" @onclick="() => Ajouter(produit.Id)"
                                                aria-label="Ajouter un @produit.Nom">+</button>
                                    </div>
                                    <div class="text-end sous-total">@((produit.Prix * quantite).ToString("C2"))</div>
                                </div>
                            </li>
                        }
                        @if (TotalConsignes > 0)
                        {
                            <li class="list-group-item ligne-consigne">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">Consigne</div>
                                        <div class="text-secondary small">
                                            @VerresConsignes verre@(VerresConsignes > 1 ? "s" : ""), rendue au retour
                                        </div>
                                    </div>
                                    <div class="text-end sous-total">+ @TotalConsignes.ToString("C2")</div>
                                </div>
                            </li>
                        }
                        @foreach (var (montant, nombre) in rendus.OrderBy(r => r.Key))
                        {
                            <li class="list-group-item ligne-consigne" @key="montant">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">Verre@(nombre > 1 ? "s" : "") rendu@(nombre > 1 ? "s" : "")</div>
                                        <div class="text-secondary small">@nombre × @montant.ToString("C2")</div>
                                    </div>
                                    <div class="btn-group" role="group" aria-label="Verres rendus à @montant.ToString("C2")">
                                        <button class="btn btn-outline-secondary" @onclick="() => RetirerRendu(montant)"
                                                aria-label="Un verre rendu de moins">−</button>
                                        <span class="btn btn-light disabled quantite">@nombre</span>
                                        <button class="btn btn-outline-secondary" @onclick="() => AjouterRendu(montant)"
                                                aria-label="Un verre rendu de plus">+</button>
                                    </div>
                                    <div class="text-end sous-total">− @((montant * nombre).ToString("C2"))</div>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="offert"
                               checked="@offerte" @onchange="e => BasculerOffert((bool)e.Value!)" />
                        <label class="form-check-label" for="offert">
                            Offert <span class="text-secondary">(bénévoles, organisateurs)</span>
                        </label>
                    </div>

                    @if (offerte && AEncaisser != 0)
                    {
                        <div class="d-flex justify-content-between align-items-baseline mb-2 text-secondary">
                            <span>Valeur offerte</span>
                            <span class="fw-semibold">@Total.ToString("C2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <span class="fs-5">
                            @(ARembourser ? "À rembourser au client" : offerte && AEncaisser == 0 ? "Valeur offerte" : "Total à payer")
                        </span>
                        <span class="total @(ARembourser ? "rembourse" : offerte && AEncaisser == 0 ? "offert" : "")">
                            @((offerte && AEncaisser == 0 ? Total : Math.Abs(AEncaisser)).ToString("C2"))
                        </span>
                    </div>

                    @if (ARembourser)
                    {
                        <div class="alert alert-info py-2 mb-3">
                            Rendez <strong class="fs-4">@((-AEncaisser).ToString("C2"))</strong> au client
                            pour ses verres rapportés.
                        </div>
                    }
                    else if (offerte && AEncaisser == 0)
                    {
                        <div class="alert alert-secondary py-2 mb-3">
                            Rien à encaisser. Le stock est décompté, mais cette commande
                            n'entre pas dans la recette attendue en caisse.
                        </div>
                    }
                    else
                    {
                        @if (offerte)
                        {
                            <div class="alert alert-secondary py-2 mb-3">
                                Les consommations sont offertes, mais pas la consigne&nbsp;: elle sera
                                rendue avec le verre.
                            </div>
                        }
                        <label class="form-label" for="recu">Montant reçu (facultatif)</label>
                        <input id="recu" class="form-control form-control-lg mb-2" type="number" step="0.01" min="0"
                               inputmode="decimal" value="@Prix.PourChamp(recu)"
                               @onchange="e => recu = Prix.Analyser(e.Value?.ToString())" />

                        @if (recu is decimal montant && AEncaisser > 0)
                        {
                            @if (montant >= AEncaisser)
                            {
                                <div class="alert alert-info py-2 mb-3">
                                    À rendre : <strong class="fs-4">@((montant - AEncaisser).ToString("C2"))</strong>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 mb-3">
                                    Il manque @((AEncaisser - montant).ToString("C2")).
                                </div>
                            }
                        }
                    }

                    <button class="btn btn-lg w-100 @(offerte ? "btn-secondary" : "btn-success")"
                            disabled="@(PanierVide || evenement.Cloture || encaissementEnCours)"
                            @onclick="EncaisserAsync">
                        @(encaissementEnCours ? "Enregistrement…"
                          : Lignes.Count == 0 && rendus.Count > 0 ? "Rembourser les verres"
                          : offerte ? "Valider l'offert"
                          : "Encaisser")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Evenement? evenement;
    private List<ProduitEnVente> produits = [];
    private bool introuvable;

    private readonly Dictionary<int, int> panier = [];
    /// <summary>Verres rapportés dans ce passage, par montant de consigne.</summary>
    private readonly Dictionary<decimal, int> rendus = [];
    private Dictionary<decimal, int> enCirculation = [];
    private decimal? recu;
    private bool offerte;

    private string? message;
    private string? erreur;
    private bool encaissementEnCours;

    private List<(ProduitEnVente Produit, int Quantite)> Lignes =>
        produits.Where(p => Quantite(p.Id) > 0)
                .Select(p => (p, Quantite(p.Id)))
                .ToList();

    /// <summary>Valeur des articles, hors consigne : c'est elle qui entre dans la recette.</summary>
    private decimal Total => Lignes.Sum(l => l.Produit.Prix * l.Quantite);

    private int VerresConsignes => Lignes.Where(l => l.Produit.AvecConsigne).Sum(l => l.Quantite);

    private decimal TotalConsignes => Lignes.Sum(l => (l.Produit.Consigne ?? 0m) * l.Quantite);

    private decimal TotalRendus => rendus.Sum(r => r.Key * r.Value);

    /// <summary>
    /// Ce que le client doit donner : négatif quand ses verres rapportés valent plus que
    /// ce qu'il achète. La consigne reste due sur une commande offerte (voir <see cref="Commande.Consignes"/>).
    /// </summary>
    private decimal AEncaisser => (offerte ? 0m : Total) + TotalConsignes - TotalRendus;

    private bool ARembourser => AEncaisser < 0;

    private bool PanierVide => Lignes.Count == 0 && rendus.Count == 0;

    /// <summary>
    /// Un bouton « verre rendu » par montant de consigne : celui des produits en vente, et
    /// celui des verres encore dehors même si leur produit a été retiré de la carte.
    /// </summary>
    private List<decimal> MontantsDeConsigne =>
        produits.Where(p => p.AvecConsigne).Select(p => p.Consigne!.Value)
            .Concat(enCirculation.Where(c => c.Value > 0).Select(c => c.Key))
            .Distinct()
            .Order()
            .ToList();

    protected override void OnInitialized() => Notifications.EvenementModifie += SurEvenementModifie;

    protected override async Task OnParametersSetAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        evenement = await Service.ChargerEvenementAsync(Id);
        introuvable = evenement is null;
        produits = evenement is null ? [] : await Service.ProduitsEnVenteAsync(Id);
        enCirculation = evenement is null ? [] : await Service.VerresEnCirculationAsync(Id);
    }

    /// <summary>
    /// Une autre caisse (ou l'écran de réglages) vient de modifier l'événement : on relit
    /// stocks, prix et clôture pour que les boutons disent la vérité sans recharger la page.
    /// </summary>
    private void SurEvenementModifie(int evenementId)
    {
        // Pendant notre propre encaissement, le signal vient de nous : la suite d'EncaisserAsync
        // recharge déjà les produits, et vérifier le panier avant qu'il soit vidé signalerait
        // à tort comme épuisés les articles que l'on vient justement de vendre.
        if (evenementId != Id || encaissementEnCours) return;
        _ = InvokeAsync(RafraichirAsync);
    }

    private async Task RafraichirAsync()
    {
        try
        {
            var avant = produits;
            await ChargerAsync();
            VerifierPanier(avant);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Sans conséquence : l'écran reste tel quel, et l'encaissement revérifie tout en base.
            Journal.LogWarning(ex, "Mise à jour en direct de la caisse impossible pour l'événement {Evenement}", Id);
        }
    }

    /// <summary>
    /// Confronte la commande en cours au stock qui vient de changer. Un article retiré de la
    /// vente disparaît du panier : il n'est plus affiché, et le laisser le ferait encaisser
    /// sans que le total à l'écran l'annonce. Un article devenu insuffisant reste en place,
    /// mais le bénévole est prévenu avant de valider plutôt qu'au moment d'encaisser.
    /// </summary>
    private void VerifierPanier(List<ProduitEnVente> avant)
    {
        var alertes = new List<string>();

        foreach (var (id, quantite) in panier.ToList())
        {
            var produit = produits.FirstOrDefault(p => p.Id == id);
            if (produit is null)
            {
                panier.Remove(id);
                var nom = avant.FirstOrDefault(p => p.Id == id)?.Nom ?? "Un article";
                alertes.Add($"« {nom} » n'est plus en vente : il a été retiré de la commande.");
            }
            else if (produit.StockRestant is int restant && quantite > restant)
            {
                alertes.Add(restant == 0
                    ? $"« {produit.Nom} » vient d'être épuisé par une autre caisse."
                    : $"Il ne reste plus que {restant} « {produit.Nom} », la commande en contient {quantite}.");
            }
        }

        foreach (var (montant, nombre) in rendus)
        {
            if (nombre > enCirculation.GetValueOrDefault(montant))
                alertes.Add($"Une autre caisse vient de rembourser des verres à {montant:C2} : "
                          + "vérifiez le nombre de verres rapportés.");
        }

        if (alertes.Count > 0) erreur = string.Join(" ", alertes);
    }

    public void Dispose() => Notifications.EvenementModifie -= SurEvenementModifie;

    private int Quantite(int produitId) => panier.GetValueOrDefault(produitId);

    /// <summary>Ce qu'il reste à prendre, une fois déduit ce qui est déjà dans le panier.</summary>
    private int? Disponible(ProduitEnVente produit) =>
        produit.StockRestant is int restant ? Math.Max(0, restant - Quantite(produit.Id)) : null;

    private void Ajouter(int produitId)
    {
        var produit = produits.FirstOrDefault(p => p.Id == produitId);
        if (produit is null) return;

        if (Disponible(produit) is 0)
        {
            erreur = produit.StockRestant == 0
                ? $"« {produit.Nom} » est épuisé."
                : $"Il ne reste que {produit.StockRestant} « {produit.Nom} », déjà tous dans la commande.";
            return;
        }

        erreur = null;
        panier[produitId] = Quantite(produitId) + 1;
        message = null;
    }

    private void Retirer(int produitId)
    {
        var restant = Quantite(produitId) - 1;
        if (restant > 0) panier[produitId] = restant;
        else panier.Remove(produitId);
    }

    private int Rendus(decimal montant) => rendus.GetValueOrDefault(montant);

    /// <summary>Verres encore remboursables, une fois déduits ceux déjà notés dans ce passage.</summary>
    private int RenduPossible(decimal montant) =>
        Math.Max(0, enCirculation.GetValueOrDefault(montant) - Rendus(montant));

    private void AjouterRendu(decimal montant)
    {
        if (RenduPossible(montant) == 0)
        {
            erreur = $"Aucun autre verre consigné à {montant:C2} n'a été vendu : rien de plus à rembourser.";
            return;
        }

        erreur = null;
        rendus[montant] = Rendus(montant) + 1;
        message = null;
    }

    private void RetirerRendu(decimal montant)
    {
        var restant = Rendus(montant) - 1;
        if (restant > 0) rendus[montant] = restant;
        else rendus.Remove(montant);
    }

    private void Vider()
    {
        panier.Clear();
        rendus.Clear();
        recu = null;
        erreur = null;
        // « Offert » ne doit jamais rester actif pour le client suivant : l'oubli
        // coûterait une recette, sans que personne ne s'en aperçoive.
        offerte = false;
    }

    private void BasculerOffert(bool valeur)
    {
        offerte = valeur;
        if (offerte) recu = null;
    }

    private async Task EncaisserAsync()
    {
        encaissementEnCours = true;
        erreur = null;
        try
        {
            var aEncaisser = AEncaisser;
            var estOfferte = offerte;
            var rendu = aEncaisser > 0 && recu is decimal m && m >= aEncaisser ? m - aEncaisser : (decimal?)null;

            var commande = await Service.EncaisserAsync(Id, panier, estOfferte, rendus);
            var paye = commande.MontantEncaisse;

            message = commande.Lignes.Count == 0
                ? $"Verres rapportés : {-paye:C2} rendus au client."
                : paye < 0
                    ? $"Commande n° {commande.Id} enregistrée : {-paye:C2} à rendre au client pour ses verres."
                    : estOfferte && paye == 0
                        ? $"Commande n° {commande.Id} offerte : {commande.Total:C2} non encaissés."
                        : estOfferte
                            ? $"Commande n° {commande.Id} offerte : {commande.Total:C2} non encaissés, consigne de {paye:C2} encaissée."
                            : rendu is decimal r && r > 0
                                ? $"Commande n° {commande.Id} encaissée : {paye:C2}. À rendre : {r:C2}."
                                : $"Commande n° {commande.Id} encaissée : {paye:C2}.";

            Vider();
            // Le stock restant et les verres en circulation viennent de changer : les boutons
            // doivent le refléter aussitôt.
            produits = await Service.ProduitsEnVenteAsync(Id);
            enCirculation = await Service.VerresEnCirculationAsync(Id);
        }
        catch (InvalidOperationException ex)
        {
            // Stock épuisé par une autre caisse, produit supprimé ou buvette clôturée
            // depuis un autre écran : on affiche la raison et on resynchronise.
            erreur = ex.Message;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            // Incident technique (base occupée, disque plein…). Le bénévole n'a que faire
            // du message d'origine : il lui faut savoir que rien n'a été encaissé, et que
            // la commande est toujours à l'écran pour être revalidée.
            Journal.LogError(ex, "Échec technique de l'encaissement sur l'événement {Evenement}", Id);
            erreur = "L'encaissement n'a pas abouti et rien n'a été enregistré. "
                   + "La commande est intacte : appuyez de nouveau sur « Encaisser ».";
        }
        finally
        {
            encaissementEnCours = false;
        }
    }
}

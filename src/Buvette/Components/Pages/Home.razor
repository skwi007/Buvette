@page "/"
@inject BuvetteService Service
@inject NavigationManager Nav

<PageTitle>Buvette — événements</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Buvettes</h1>
    <button class="btn btn-primary btn-lg" @onclick="OuvrirFormulaire">+ Nouvel événement</button>
</div>

@if (formulaireOuvert)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Nouvel événement</h2>
            <EditForm Model="nouveau" OnValidSubmit="CreerAsync" FormName="nouvelEvenement">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="nom">Nom</label>
                        <InputText id="nom" class="form-control form-control-lg" @bind-Value="nouveau.Nom"
                                   placeholder="Fête de l'école" />
                        <ValidationMessage For="() => nouveau.Nom" class="text-danger small" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="date">Date</label>
                        <InputDate id="date" class="form-control form-control-lg" @bind-Value="nouveau.Date" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="fond">Fond de caisse (€)</label>
                        <InputNumber id="fond" class="form-control form-control-lg" @bind-Value="nouveau.FondDeCaisse"
                                     step="0.01" />
                        <ValidationMessage For="() => nouveau.FondDeCaisse" class="text-danger small" />
                    </div>
                    @if (evenements.Count > 0)
                    {
                        <div class="col-12">
                            <label class="form-label" for="modele">Reprendre les produits d'un événement précédent</label>
                            <select id="modele" class="form-select" value="@modeleId"
                                    @onchange="e => modeleId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value!.ToString()!)">
                                <option value="">— Partir d'une liste vide —</option>
                                @foreach (var e in evenements)
                                {
                                    <option value="@e.Id">@e.Nom (@e.Date.ToString("d MMMM yyyy"))</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Créer</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="() => formulaireOuvert = false">
                        Annuler
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (evenements.Count == 0)
{
    <p class="text-secondary fs-5">
        Aucun événement pour l'instant. Créez-en un, ajoutez-y vos produits et leurs prix,
        puis ouvrez la caisse le jour J.
    </p>
}
else
{
    <div class="row g-3">
        @foreach (var e in evenements)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 @(e.Cloture ? "border-secondary opacity-75" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h2 class="h5 mb-1">@e.Nom</h2>
                            @if (e.Cloture)
                            {
                                <span class="badge text-bg-secondary">Clôturé</span>
                            }
                        </div>
                        <p class="text-secondary mb-3">@e.Date.ToString("dddd d MMMM yyyy")</p>
                        <div class="mt-auto d-flex flex-wrap gap-2">
                            @if (!e.Cloture)
                            {
                                <a class="btn btn-primary" href="/caisse/@e.Id">Caisse</a>
                            }
                            <a class="btn btn-outline-secondary" href="/evenement/@e.Id">Produits</a>
                            <a class="btn btn-outline-secondary" href="/historique/@e.Id">Historique</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Evenement> evenements = [];
    private Evenement nouveau = new();
    private int? modeleId;
    private bool formulaireOuvert;

    protected override async Task OnInitializedAsync() => evenements = await Service.ListerEvenementsAsync();

    private void OuvrirFormulaire()
    {
        nouveau = new Evenement();
        // Le plus souvent on reconduit la carte de la dernière buvette : on la propose par défaut.
        modeleId = evenements.FirstOrDefault()?.Id;
        formulaireOuvert = true;
    }

    private async Task CreerAsync()
    {
        var id = await Service.CreerEvenementAsync(nouveau, modeleId);
        Nav.NavigateTo($"/evenement/{id}");
    }
}
